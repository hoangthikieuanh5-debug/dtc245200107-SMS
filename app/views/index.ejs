<%
// Inject layout manually since we're not using a layout engine
const activePage = 'home';
%>
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Trang chủ | Hệ thống Quản lý Sinh viên</title>
  <meta name="description" content="Hệ thống Quản lý Sinh viên - CRUD sinh viên, lớp học, điểm số">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
</head>
<body>

<nav class="navbar navbar-expand-lg navbar-dark sticky-top" id="mainNav">
  <div class="container-fluid px-4">
    <a class="navbar-brand d-flex align-items-center gap-2" href="/">
      <div class="brand-icon"><i class="bi bi-mortarboard-fill"></i></div>
      <span class="fw-700">SMS <span class="brand-sub">Student Manager</span></span>
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav ms-auto gap-1">
        <li class="nav-item"><a class="nav-link active" href="/"><i class="bi bi-house-fill me-1"></i>Trang chủ</a></li>
        <li class="nav-item"><a class="nav-link" href="/sinh-vien"><i class="bi bi-people-fill me-1"></i>Sinh viên</a></li>
        <li class="nav-item"><a class="nav-link" href="/lop"><i class="bi bi-building-fill me-1"></i>Lớp học</a></li>
        <li class="nav-item"><a class="nav-link" href="/diem"><i class="bi bi-bar-chart-fill me-1"></i>Điểm số</a></li>
        <li class="nav-item ms-2"><a class="nav-link btn-metrics" href="/metrics" target="_blank"><i class="bi bi-activity me-1"></i>Metrics</a></li>
      </ul>
    </div>
  </div>
</nav>

<main class="main-content">
  <div class="container-fluid px-4">

    <!-- Hero Section -->
    <div class="hero-home fade-in" style="
      background: linear-gradient(135deg, #1e1b4b 0%, #0c1445 50%, #0f172a 100%);
      border: 1px solid rgba(79,70,229,0.2);
      border-radius: 16px;
      padding: 3rem;
      margin-bottom: 2rem;
      position: relative; overflow: hidden;">
      <div style="position:absolute;top:-80px;right:-80px;width:300px;height:300px;
        background:radial-gradient(circle,rgba(79,70,229,0.25) 0%,transparent 70%);border-radius:50%;"></div>
      <div style="position:absolute;bottom:-60px;left:-60px;width:200px;height:200px;
        background:radial-gradient(circle,rgba(6,182,212,0.15) 0%,transparent 70%);border-radius:50%;"></div>
      <div class="row align-items-center">
        <div class="col-lg-8">
          <div style="display:inline-flex;align-items:center;gap:0.5rem;
            background:rgba(79,70,229,0.15);border:1px solid rgba(79,70,229,0.3);
            border-radius:20px;padding:0.3rem 1rem;margin-bottom:1rem;">
            <span style="width:8px;height:8px;background:#4f46e5;border-radius:50%;animation:pulse 2s infinite;"></span>
            <span style="color:#818cf8;font-size:0.78rem;font-weight:600;">SYSTEM ONLINE</span>
          </div>
          <h1 style="font-size:2.5rem;font-weight:800;color:#f1f5f9;line-height:1.2;margin-bottom:1rem;">
            Hệ thống Quản lý<br>
            <span style="background:linear-gradient(135deg,#4f46e5,#06b6d4);-webkit-background-clip:text;-webkit-text-fill-color:transparent;">Sinh viên</span>
          </h1>
          <p style="color:#94a3b8;font-size:1rem;max-width:500px;line-height:1.6;">
            Quản lý toàn diện thông tin sinh viên, lớp học và điểm số. Triển khai bằng Docker Compose với kiến trúc Microservices.
          </p>
          <div class="d-flex gap-3 mt-4 flex-wrap">
            <a href="/sinh-vien" class="btn-primary-custom btn" id="btnGoStudents">
              <i class="bi bi-people-fill me-2"></i>Quản lý Sinh viên
            </a>
            <a href="/lop" class="btn" id="btnGoClasses" style="background:rgba(6,182,212,0.15);border:1px solid rgba(6,182,212,0.3);color:#22d3ee;font-weight:600;border-radius:8px;padding:0.6rem 1.5rem;">
              <i class="bi bi-building-fill me-2"></i>Quản lý Lớp học
            </a>
          </div>
        </div>
        <div class="col-lg-4 text-center mt-4 mt-lg-0">
          <div style="font-size:8rem;line-height:1;
            background:linear-gradient(135deg,#4f46e5,#06b6d4);
            -webkit-background-clip:text;-webkit-text-fill-color:transparent;">
            🎓
          </div>
        </div>
      </div>
    </div>

    <!-- Stats Row -->
    <div class="row g-3 mb-4">
      <div class="col-sm-6 col-lg-3 fade-in delay-1">
        <a href="/sinh-vien" class="text-decoration-none">
          <div class="stat-card" style="--grad-color:linear-gradient(90deg,#4f46e5,#818cf8);">
            <div class="stat-icon" style="background:rgba(79,70,229,0.15);color:#818cf8;">
              <i class="bi bi-people-fill"></i>
            </div>
            <div class="stat-value" id="stat-sv">—</div>
            <div class="stat-label">Sinh viên</div>
          </div>
        </a>
      </div>
      <div class="col-sm-6 col-lg-3 fade-in delay-2">
        <a href="/lop" class="text-decoration-none">
          <div class="stat-card" style="--grad-color:linear-gradient(90deg,#06b6d4,#22d3ee);">
            <div class="stat-icon" style="background:rgba(6,182,212,0.15);color:#22d3ee;">
              <i class="bi bi-building-fill"></i>
            </div>
            <div class="stat-value" id="stat-lop">—</div>
            <div class="stat-label">Lớp học</div>
          </div>
        </a>
      </div>
      <div class="col-sm-6 col-lg-3 fade-in delay-3">
        <a href="/diem" class="text-decoration-none">
          <div class="stat-card" style="--grad-color:linear-gradient(90deg,#10b981,#34d399);">
            <div class="stat-icon" style="background:rgba(16,185,129,0.15);color:#34d399;">
              <i class="bi bi-bar-chart-fill"></i>
            </div>
            <div class="stat-value" id="stat-diem">—</div>
            <div class="stat-label">Bản ghi điểm</div>
          </div>
        </a>
      </div>
      <div class="col-sm-6 col-lg-3 fade-in delay-3">
        <a href="/health" class="text-decoration-none" target="_blank">
          <div class="stat-card" style="--grad-color:linear-gradient(90deg,#f59e0b,#fbbf24);">
            <div class="stat-icon" style="background:rgba(245,158,11,0.15);color:#fbbf24;">
              <i class="bi bi-heart-pulse-fill"></i>
            </div>
            <div class="stat-value" style="font-size:1.2rem;padding-top:0.4rem;" id="stat-health">Healthy</div>
            <div class="stat-label">Trạng thái hệ thống</div>
          </div>
        </a>
      </div>
    </div>

    <!-- Quick Actions -->
    <div class="row g-3">
      <div class="col-md-4 fade-in delay-1">
        <div class="card-dark p-0">
          <div class="card-header">
            <h6 class="mb-0 text-light"><i class="bi bi-lightning-fill text-warning me-2"></i>Thao tác nhanh</h6>
          </div>
          <div class="p-3 d-flex flex-column gap-2">
            <a href="/sinh-vien/create" class="btn btn-sm d-flex align-items-center gap-2" id="quickAddStudent"
              style="background:rgba(79,70,229,0.15);border:1px solid rgba(79,70,229,0.3);color:#a5b4fc;border-radius:8px;padding:0.6rem 1rem;">
              <i class="bi bi-person-plus-fill"></i> Thêm sinh viên mới
            </a>
            <a href="/lop/create" class="btn btn-sm d-flex align-items-center gap-2" id="quickAddClass"
              style="background:rgba(6,182,212,0.15);border:1px solid rgba(6,182,212,0.3);color:#22d3ee;border-radius:8px;padding:0.6rem 1rem;">
              <i class="bi bi-plus-circle-fill"></i> Thêm lớp học mới
            </a>
            <a href="/diem/create" class="btn btn-sm d-flex align-items-center gap-2" id="quickAddGrade"
              style="background:rgba(16,185,129,0.15);border:1px solid rgba(16,185,129,0.3);color:#34d399;border-radius:8px;padding:0.6rem 1rem;">
              <i class="bi bi-pencil-fill"></i> Nhập điểm mới
            </a>
          </div>
        </div>
      </div>

      <div class="col-md-8 fade-in delay-2">
        <div class="card-dark p-0" style="height:100%;">
          <div class="card-header d-flex align-items-center justify-content-between">
            <h6 class="mb-0 text-light"><i class="bi bi-stack text-primary me-2"></i>Tech Stack</h6>
            <span style="font-size:0.72rem;color:#64748b;">Docker Compose</span>
          </div>
          <div class="p-3">
            <div class="row g-2">
              <% const stack = [
                {icon:'bi-node-plus-fill', label:'Node.js', sub:'Express + EJS', color:'#68a063'},
                {icon:'bi-database-fill', label:'MySQL 8.0', sub:'Relational DB', color:'#00758f'},
                {icon:'bi-shield-shaded', label:'Nginx', sub:'Reverse Proxy + SSL', color:'#269539'},
                {icon:'bi-activity', label:'Prometheus', sub:'Metrics Scraping', color:'#e6522c'},
                {icon:'bi-graph-up-arrow', label:'Grafana', sub:'Visualization', color:'#f46800'},
                {icon:'bi-journal-text', label:'Loki + Promtail', sub:'Log Aggregation', color:'#4fbdba'},
              ] %>
              <% stack.forEach(s => { %>
              <div class="col-6 col-md-4">
                <div style="background:rgba(15,23,42,0.6);border:1px solid rgba(51,65,85,0.5);
                  border-radius:8px;padding:0.75rem;display:flex;align-items:center;gap:0.75rem;">
                  <i class="bi <%= s.icon %>" style="font-size:1.3rem;color:<%= s.color %>;"></i>
                  <div>
                    <div style="font-size:0.8rem;font-weight:600;color:#e2e8f0;"><%= s.label %></div>
                    <div style="font-size:0.7rem;color:#64748b;"><%= s.sub %></div>
                  </div>
                </div>
              </div>
              <% }) %>
            </div>
          </div>
        </div>
      </div>
    </div>

  </div>
</main>

<footer class="footer mt-4 py-3">
  <div class="container text-center">
    <span class="text-muted small">
      <i class="bi bi-shield-check text-success me-1"></i>
      Hệ thống Quản lý Sinh viên &copy; 2024 — Node.js + MySQL + Docker
    </span>
  </div>
</footer>

<style>
@keyframes pulse { 0%,100%{opacity:1} 50%{opacity:0.4} }
</style>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script>
// Fetch stats from API
fetch('/health').then(r=>r.json()).then(d=>{
  document.getElementById('stat-health').textContent = d.status === 'healthy' ? '✅ Online' : '❌ Offline';
}).catch(()=>{
  document.getElementById('stat-health').textContent = '⚠️ Check';
});
// Fetch counts
async function loadStats() {
  try {
    const [sv, lop, diem] = await Promise.all([
      fetch('/sinh-vien').then(r => { return null; }),
    ]);
  } catch(e){}
}
</script>
<script src="/app.js"></script>
</body>
</html>
