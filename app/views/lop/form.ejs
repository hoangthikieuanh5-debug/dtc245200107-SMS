<%- include('../_head', {title: title}) %>
<div class="container-fluid px-4">
  <div class="page-hero fade-in" style="--hero-color:#06b6d4;">
    <div class="hero-icon" style="background:linear-gradient(135deg,#06b6d4,#0e7490);">
      <i class="bi bi-<%= cls ? 'pencil-square' : 'plus-circle-fill' %>"></i>
    </div>
    <h1><%= title %></h1>
    <p><%= cls ? `Chỉnh sửa thông tin lớp: ${cls.ma_lop}` : 'Tạo lớp học mới trong hệ thống' %></p>
  </div>

  <div class="row justify-content-center">
    <div class="col-lg-7">
      <div class="card-dark p-0 fade-in delay-1">
        <div class="card-header">
          <h6 class="mb-0 text-light"><i class="bi bi-building me-2 text-info"></i>Thông tin lớp học</h6>
        </div>
        <div class="p-4">
          <form method="POST" action="<%= action %>" class="form-dark" id="classForm">
            <div class="row g-3">
              <div class="col-md-5">
                <label class="form-label" for="ma_lop">Mã Lớp *</label>
                <input type="text" class="form-control" id="ma_lop" name="ma_lop"
                  value="<%= cls ? cls.ma_lop : '' %>"
                  <%= cls ? 'readonly style="opacity:0.6"' : 'required' %>
                  placeholder="VD: CNTT01">
              </div>
              <div class="col-md-7">
                <label class="form-label" for="ten_lop">Tên Lớp *</label>
                <input type="text" class="form-control" id="ten_lop" name="ten_lop"
                  value="<%= cls ? cls.ten_lop : '' %>"
                  required placeholder="VD: Công nghệ thông tin K01">
              </div>
              <div class="col-md-6">
                <label class="form-label" for="khoa">Khoa *</label>
                <input type="text" class="form-control" id="khoa" name="khoa"
                  value="<%= cls ? cls.khoa : '' %>"
                  required placeholder="VD: Công nghệ thông tin">
              </div>
              <div class="col-md-6">
                <label class="form-label" for="he_dao_tao">Hệ đào tạo</label>
                <select class="form-select" id="he_dao_tao" name="he_dao_tao">
                  <% ['Chính quy','Liên thông','Vừa làm vừa học','Cao học'].forEach(h => { %>
                    <option value="<%= h %>" <%= (cls && cls.he_dao_tao === h) ? 'selected' : '' %>><%= h %></option>
                  <% }) %>
                </select>
              </div>
              <div class="col-md-5">
                <label class="form-label" for="nien_khoa">Niên khóa *</label>
                <input type="text" class="form-control" id="nien_khoa" name="nien_khoa"
                  value="<%= cls ? cls.nien_khoa : '' %>"
                  required placeholder="VD: 2022-2026">
              </div>
              <div class="col-md-7">
                <label class="form-label" for="giao_vien_chu_nhiem">Giáo viên chủ nhiệm</label>
                <input type="text" class="form-control" id="giao_vien_chu_nhiem" name="giao_vien_chu_nhiem"
                  value="<%= cls ? cls.giao_vien_chu_nhiem || '' : '' %>"
                  placeholder="VD: TS. Nguyễn Văn A">
              </div>
            </div>

            <div class="d-flex gap-3 mt-4">
              <button type="submit" class="btn btn-primary-custom" id="btnSubmitClass">
                <i class="bi bi-<%= cls ? 'check-circle-fill' : 'plus-circle-fill' %> me-2"></i>
                <%= cls ? 'Cập nhật' : 'Thêm Lớp học' %>
              </button>
              <a href="/lop" class="btn" style="background:rgba(100,116,139,0.15);border:1px solid rgba(100,116,139,0.3);color:#94a3b8;border-radius:8px;padding:0.6rem 1.5rem;font-weight:600;">
                <i class="bi bi-arrow-left me-2"></i>Quay lại
              </a>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
<%- include('../_foot') %>
